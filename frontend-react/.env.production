VITE_AZURE_CLIENT_ID=f345fdc4-1687-49d0-b0cc-e0d45eb85731
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/680da6eb-42e0-4147-bda4-8c06e4819411
VITE_AZURE_REDIRECT_URI=https://inmobiliariasduoc.duckdns.org/

# Scope delegado que expone nuestra API en Entra ID (Expose an API ->
# api://{client-id}/access_as_user). El access token que se envia al backend
# se pide con este scope, y es el mismo que exige el API Gateway.
VITE_AZURE_API_SCOPE=api://f345fdc4-1687-49d0-b0cc-e0d45eb85731/access_as_user

# URL publica del API Gateway de AWS (salida ApiInvokeUrl del stack), sin barra
# final. Reemplazar REEMPLAZAR-API-ID por el id que devuelve el despliegue.
VITE_API_BASE_URL=https://ffhwaj153l.execute-api.us-east-1.amazonaws.com

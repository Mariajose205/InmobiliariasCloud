# Azure Entra ID Configuration
VITE_AZURE_CLIENT_ID=f345fdc4-1687-49d0-b0cc-e0d45eb85731
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/680da6eb-42e0-4147-bda4-8c06e4819411
VITE_AZURE_REDIRECT_URI=https://inmobiliariasduoc.duckdns.org/

# Scope que expone la API en Entra ID (Expose an API -> access_as_user).
# Es el mismo valor que el parametro AzureApiScope de api-gateway.yaml.
VITE_AZURE_API_SCOPE=api://f345fdc4-1687-49d0-b0cc-e0d45eb85731/access_as_user

# URL publica del API Gateway de AWS, tal como aparece en la salida
# ApiInvokeUrl del stack. Sin barra final.
#
# El navegador llama a esta URL directamente, ya no a https://inmobiliariasduoc.duckdns.org,
# porque el proxy /api de nginx se elimino. Como son origenes distintos, el
# CORS lo resuelve el propio API Gateway.
VITE_API_BASE_URL=https://REEMPLAZAR-API-ID.execute-api.us-east-1.amazonaws.com

# Copia este archivo como ".env" en esta misma carpeta y ajusta los valores.
# NUNCA subas el ".env" real al repositorio (ya esta en .gitignore).

# Base de datos PostgreSQL (servicio "db" del docker-compose)
POSTGRES_DB=inmobiliarias
POSTGRES_USER=inmob_admin
POSTGRES_PASSWORD=cambia_esta_password

# Identidad de los usuarios con rol, tal como aparecen en Entra ID.
# El microservicio las usa para resolver el rol de quien hace cada operacion y
# asi dejar registro en la tabla de auditoria. La validacion del token de
# Microsoft la hace API Gateway, no estos valores.
ADMIN_EMAIL=administrador@inmobiliariaduoc.onmicrosoft.com
ADMIN_OID=5ce11c6e-c796-41eb-b8ed-1872878cd197
CORREDOR_EMAIL=Corredor@InmobiliariaDuoc.onmicrosoft.com
CORREDOR_OID=0a73de94-2722-4221-836c-bd7f3af16980

# Ya no se usan JWT_SECRET ni ADMIN_PASSWORD: pertenecían al api-gateway de
# Spring Boot, que emitia su propio token y fue reemplazado por API Gateway.
